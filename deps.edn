{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.jetbrains.kotlin/kotlin-stdlib {:mvn/version "2.4.20"}
        org.jetbrains.kotlin/kotlin-metadata-jvm {:mvn/version "2.4.20"}}
 :aliases
 {;; kotlinx-coroutines, for `suspend` functions. As a top-level dependency it wins over the older
  ;; coroutines that the alias :kotlinc brings.
  :coro {:extra-deps {org.jetbrains.kotlinx/kotlinx-coroutines-core-jvm {:mvn/version "1.10.2"}}}
  ;; the newest kotlinx-coroutines, whose `runBlocking` is in two parts of its multi-file facade (bin/test runs the
  ;; coroutine tests again with it). Put it after :coro: override-deps wins over every other version.
  :coro-next {:override-deps {org.jetbrains.kotlinx/kotlinx-coroutines-core-jvm {:mvn/version "1.11.0"}}}
  :test {:extra-paths ["test" "target/fixtures"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; kt compiles a Kotlin bridge for an `inline reified` call (`:<>`), in this JVM, with the Kotlin
  ;; compiler. Not a dependency of the library: add this alias (version = kotlin-metadata-jvm above)
  ;; to run or AOT-compile code that calls a reified function. A bridge that is stored (the disk
  ;; cache, or classes AOT-compiled with the code) needs no compiler.
  ;; kotlin-reflect is excluded: the compiler asks for 1.6.10 and runs without it.
  ;; The compiler brings kotlinx-coroutines 1.8.0 and fails with INTERNAL_ERROR without it; if you
  ;; also add :coro (or have the dependency yourself), your version is used.
  :kotlinc {:extra-deps {org.jetbrains.kotlin/kotlin-compiler-embeddable
                         {:mvn/version "2.4.20" :exclusions [org.jetbrains.kotlin/kotlin-reflect]}}}
  ;; the examples: the compiled Kotlin libraries `shop` and `web` (examples/build) and kotlinx.coroutines
  :examples {:extra-paths ["." "examples/target/classes"]
             :extra-deps {org.jetbrains.kotlinx/kotlinx-coroutines-core-jvm {:mvn/version "1.10.2"}}}}}
