#!/bin/sh
# Build the Kotlin fixtures, then run all tests. Exit non-zero on failure.
cd "$(dirname "$0")/.." || exit 1
bin/build-fixtures || exit 1
clojure -M:test:coro:kotlinc -r 'ckway\.(meta|call|fn|aot|value|bridge|co|suspend|types|reified|reified-jvm|hardening|static|set|ref|data|cache|reify|fixes|web|stdlib|select|robust)-test' || exit 1
# stdlib only: no kotlinx.coroutines on the class path
clojure -M:test -n ckway.nocoro-test || exit 1
# the newest kotlinx-coroutines (1.11.0: `runBlocking` is declared twice in the facade): the coroutine tests again
clojure -M:test:coro:coro-next:kotlinc -n ckway.coro-next-test -n ckway.suspend-test
