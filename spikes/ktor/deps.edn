{:paths ["src"]
 :deps {io.github.vadym-lopatka/ckway {:local/root "../.."}
        org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.jetbrains.kotlinx/kotlinx-coroutines-core-jvm {:mvn/version "1.11.0"}
        io.ktor/ktor-server-core-jvm {:mvn/version "3.6.0"}
        io.ktor/ktor-server-cio-jvm {:mvn/version "3.6.0"}
        io.ktor/ktor-server-status-pages-jvm {:mvn/version "3.6.0"}
        io.ktor/ktor-server-call-logging-jvm {:mvn/version "3.6.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}
 :aliases
 {:run {:main-opts ["-m" "spike.ktor.core"]
        :jvm-opts ["-Dckway.cache.dir=target/cache" "--enable-native-access=ALL-UNNAMED"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.ktor/ktor-server-test-host-jvm {:mvn/version "3.6.0"}
                      io.ktor/ktor-client-core-jvm {:mvn/version "3.6.0"}
                      io.ktor/ktor-client-cio-jvm {:mvn/version "3.6.0"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["-Dckway.cache.dir=target/cache" "--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}
  :kotlinc {:extra-deps {org.jetbrains.kotlin/kotlin-compiler-embeddable
                         {:mvn/version "2.4.20" :exclusions [org.jetbrains.kotlin/kotlin-reflect]}}}}}
